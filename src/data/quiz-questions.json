    { "topic": "real-numbers", "section": "تمارين على الأعداد الحقيقية", "page": 11, "number": 15, "body": "$\\sqrt{\\frac{1}{x^{2}}+y^{-4}}=$", "options": ["$\\frac{1}{|x|}+\\frac{1}{y^{2}}$", "$\\frac{\\sqrt{x^{2}+y^{4}}}{|x|y^{2}}$", "$\\frac{1}{x}+\\frac{1}{y^{2}}$", "$\\frac{\\sqrt{x^{2}+y^{4}}}{xy^{2}}$"], "answerIndex": 1, "verified": false, "work": "المقام المشترك x²y⁴ ويلزم |x| لأن الجذر موجب" },
    { "topic": "real-numbers", "section": "تمارين على الأعداد الحقيقية", "page": 12, "number": 16, "body": "اذا كان العدد $a$ هو المعكوس الضربي للعدد $\\frac{2}{3}$ ، و $b$ هو المعكوس الجمعي للعدد $\\frac{\\sqrt{5}}{2}$ فإن $\\frac{1}{a+b}=$", "options": ["$\\frac{3+\\sqrt{5}}{2}$", "$\\frac{1}{2}$", "$\\frac{3-\\sqrt{5}}{2}$", "$\\frac{-1}{2}$"], "answerIndex": 0, "verified": false, "work": "a=3/2 و b=−√5/2 فيكون 2/(3−√5) = (3+√5)/2" },

