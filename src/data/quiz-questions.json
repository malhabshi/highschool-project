    { "topic": "real-numbers", "section": "تمارين على الأعداد الحقيقية", "page": 11, "number": 12, "body": "$\\frac{\\frac{1}{x+2}-\\frac{1}{x}}{\\frac{1}{x+2}}=$", "options": ["$\\frac{-x}{2}$", "$-\\frac{2}{x}$", "$-x$", "$\\frac{-1}{x}$"], "answerIndex": 1, "verified": false, "work": "البسط −2/(x(x+2)) مضروبا في (x+2) = −2/x" },
