    { "topic": "polynomials", "section": "تمارين على الحدوديات", "page": 18, "number": 7, "body": "$\\left(\\frac{2}{x+5}-4\\right)\\left(\\frac{x}{2x+9}\\right)=$", "options": ["$\\frac{-x}{x+5}$", "$\\frac{-2x}{x+5}$", "$\\frac{x}{x+5}$", "$\\frac{2x}{x+5}$"], "answerIndex": 1, "verified": false, "work": "(−4x−18)/(x+5) × x/(2x+9) = −2x/(x+5)" },
