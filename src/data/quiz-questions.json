    { "topic": "polynomials", "section": "تمارين على الحدوديات", "page": 16, "number": 2, "body": "$\\frac{(2x+3)^{2}-9}{4x}=$", "options": ["$2x+3$", "$x-3$", "$2x-3$", "$x+3$"], "answerIndex": 3, "verified": false, "work": "(4x²+12x)/4x = x+3" },
